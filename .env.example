# Public base URL used for canonical and Open Graph metadata.
# Vite replaces %VITE_SITE_URL% inside index.html at build time.
VITE_SITE_URL=http://localhost:5173

# Base for product photography. Defaults to the Unsplash image CDN;
# point it at your own CDN when you replace the demo imagery.
VITE_IMAGE_CDN_BASE=https://images.unsplash.com
